# CutLog AI configuration
#
# API keys are entered in the app (Settings → AI keys) and stored on the phone.
# Do not put real keys here — react-native-dotenv would bake them into the APK.
#
# Never commit a real .env file.

GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.1-8b-instruct

AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=nvidia
