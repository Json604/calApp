# CutLog AI configuration
#
# API keys embedded in a mobile app can be extracted from the package.
# This is acceptable for a personal prototype. A production/public version
# should proxy Groq/NVIDIA requests through a backend or secure gateway.
#
# Never commit a real .env file.

GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.1-8b-instruct

AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=nvidia
